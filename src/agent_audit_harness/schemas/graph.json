{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common graph contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "target",
    "engine",
    "source_index",
    "input_config",
    "functions",
    "calls",
    "file_calls",
    "scope_calls",
    "coverage",
    "limitations",
    "identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_index": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "lines"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "lines": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "input_config": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "lines"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "lines": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "scope",
          "kind",
          "name",
          "qualified_name",
          "signature",
          "path",
          "line",
          "end_line",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "qualified_name": {
            "type": "string",
            "minLength": 1
          },
          "signature": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          },
          "metadata": {
            "type": "object"
          },
          "context_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "end_column": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "caller",
          "callee",
          "callee_name",
          "path",
          "line",
          "column",
          "kind",
          "dispatch",
          "execution",
          "status",
          "reason",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "caller": {
            "type": "string",
            "minLength": 1
          },
          "callee": {
            "type": [
              "string",
              "null"
            ]
          },
          "callee_name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "const": "call"
          },
          "dispatch": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "enum": [
              "normal",
              "concurrent",
              "deferred"
            ]
          },
          "status": {
            "enum": [
              "resolved",
              "external",
              "unresolved",
              "ambiguous"
            ]
          },
          "reason": {
            "type": "string"
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object"
          },
          "function_arguments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/functionArgument"
            }
          }
        }
      }
    },
    "file_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caller_file",
          "callee_file",
          "call_ids"
        ],
        "properties": {
          "caller_file": {
            "type": "string"
          },
          "callee_file": {
            "type": "string"
          },
          "call_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scope_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caller_scope",
          "callee_scope",
          "call_ids"
        ],
        "properties": {
          "caller_scope": {
            "type": "string"
          },
          "callee_scope": {
            "type": "string"
          },
          "call_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "units",
        "skipped",
        "unvisited_sources",
        "configuration_verified"
      ],
      "properties": {
        "status": {
          "enum": [
            "parsed",
            "partial"
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "unvisited_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "configuration_verified": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "scope",
        "kind",
        "name",
        "path",
        "line",
        "end_line",
        "references"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "preamble",
            "type",
            "value"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "functionArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "function",
        "name",
        "status",
        "reason"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "function": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "resolved",
            "external",
            "unresolved",
            "ambiguous"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
