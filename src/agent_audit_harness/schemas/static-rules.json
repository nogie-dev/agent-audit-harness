{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "rules": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "language", "cwe", "source_patterns", "sink_patterns", "sanitizer_patterns", "assumptions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "language": {"enum": ["python", "go"]},
          "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
          "call_models": {
            "type": "object", "additionalProperties": false, "required": ["source", "sink"],
            "properties": {
              "source": {"type": "string", "minLength": 1, "maxLength": 128},
              "sink": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          },
          "source_patterns": {"$ref": "#/$defs/patterns"},
          "sink_patterns": {"$ref": "#/$defs/patterns"},
          "sanitizer_patterns": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/pattern"}},
          "assumptions": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
        }
      }
    }
  },
  "$defs": {
    "pattern": {"type": "string", "minLength": 1, "maxLength": 4096},
    "patterns": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/pattern"}}
  }
}
