{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-backed research hypotheses (not confirmed exposure)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypotheses"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "hypotheses": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "question", "entry", "assumptions", "annotations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "question": {"type": "string", "minLength": 1, "maxLength": 2000},
          "entry": {"type": "string", "minLength": 1, "maxLength": 1024},
          "assumptions": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
          "annotations": {
            "type": "array", "maxItems": 32,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["role", "function", "claim", "evidence"],
              "properties": {
                "role": {"enum": ["source", "sink", "barrier_candidate", "boundary"]},
                "function": {"type": "string", "minLength": 1, "maxLength": 1024},
                "claim": {"type": "string", "minLength": 1, "maxLength": 1000},
                "evidence": {
                  "type": "object", "additionalProperties": false,
                  "required": ["path", "line", "quote"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1, "maxLength": 1024},
                    "line": {"type": "integer", "minimum": 1},
                    "quote": {"type": "string", "minLength": 1, "maxLength": 1000}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
