{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-backed recon proposals; priorities and exposure remain hypotheses",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypotheses",
    "unresolved"
  ],
  "properties": {
    "hypotheses": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "entry",
          "assumptions",
          "annotations",
          "selection"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "entry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "assumptions": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "annotations": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "function",
                "claim",
                "evidence"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "source",
                    "sink",
                    "barrier_candidate",
                    "boundary"
                  ]
                },
                "function": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "evidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "line",
                    "quote"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "column": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "priority",
              "rationale",
              "entry_evidence",
              "fact_ids",
              "unresolved"
            ],
            "properties": {
              "priority": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "entry_evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "line",
                  "column",
                  "quote"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              },
              "fact_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^rf-[a-f0-9]{24}$"
                }
              },
              "unresolved": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
