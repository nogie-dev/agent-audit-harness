{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static analyzer evidence v1, separate from common graph v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "target", "language", "graph_sha256", "source_index", "engine", "rule_spec", "rules_sha256", "observations", "taint_results", "gaps", "coverage", "limitations", "identity_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {"type": "string", "minLength": 1},
    "language": {"enum": ["python", "go"]},
    "graph_sha256": {"$ref": "#/$defs/hash"},
    "rules_sha256": {"$ref": "#/$defs/hash"},
    "identity_sha256": {"$ref": "#/$defs/hash"},
    "source_index": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "lines"],
      "properties": {"path": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 0}, "lines": {"type": "integer", "minimum": 0}}
    }},
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "scope", "core_sha256", "runtime_sha256", "adapter_sha256", "normalizer_sha256", "requirements_sha256", "generated_rules_sha256", "target_execution", "remote_rules"],
      "properties": {
        "name": {"const": "semgrep_ce_core"}, "version": {"const": "1.180.0"}, "scope": {"const": "intraprocedural"},
        "core_sha256": {"$ref": "#/$defs/hash"}, "runtime_sha256": {"$ref": "#/$defs/hash"}, "adapter_sha256": {"$ref": "#/$defs/hash"}, "normalizer_sha256": {"$ref": "#/$defs/hash"}, "requirements_sha256": {"$ref": "#/$defs/hash"}, "generated_rules_sha256": {"$ref": "#/$defs/hash"},
        "target_execution": {"const": false}, "remote_rules": {"const": false}
      }
    },
    "rule_spec": {"type": "object"},
    "observations": {"type": "array", "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rule_id", "role", "provenance", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "rule_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["source", "sink", "sanitizer"]}, "provenance": {"const": "semgrep_pattern"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }},
    "taint_results": {"type": "array", "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rule_id", "provenance", "source", "sink", "steps", "trace_status", "gap_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "rule_id": {"$ref": "#/$defs/id"}, "provenance": {"const": "semgrep_taint"},
        "source": {"anyOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]}, "sink": {"$ref": "#/$defs/evidence"},
        "steps": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/evidence"}},
        "trace_status": {"enum": ["reported", "partial"]}, "gap_ids": {"$ref": "#/$defs/ids"}
      }
    }},
    "gaps": {"type": "array", "maxItems": 100000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "reason", "provenance", "detail", "call_id", "function_id", "path", "finding_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "reason": {"$ref": "#/$defs/id"},
        "provenance": {"enum": ["graph_structure", "semgrep_ce", "adapter_scope"]}, "detail": {"type": "string", "maxLength": 8000},
        "call_id": {"$ref": "#/$defs/nullableId"}, "function_id": {"$ref": "#/$defs/nullableId"},
        "path": {"$ref": "#/$defs/nullableId"}, "finding_id": {"$ref": "#/$defs/nullableId"}
      }
    }},
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["status", "scanned_files", "note"],
      "properties": {"status": {"enum": ["analyzed", "partial"]}, "scanned_files": {"$ref": "#/$defs/ids"}, "note": {"$ref": "#/$defs/id"}}
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableId": {"type": ["string", "null"], "minLength": 1},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "line", "column", "end_line", "end_column", "start_offset", "end_offset", "quote", "source_sha256", "function_id", "call_ids"],
      "properties": {
        "path": {"$ref": "#/$defs/id"}, "line": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}, "end_column": {"type": "integer", "minimum": 1},
        "start_offset": {"type": "integer", "minimum": 0}, "end_offset": {"type": "integer", "minimum": 1},
        "quote": {"$ref": "#/$defs/id"}, "source_sha256": {"$ref": "#/$defs/hash"},
        "function_id": {"$ref": "#/$defs/nullableId"}, "call_ids": {"$ref": "#/$defs/ids"}
      }
    }
  }
}
