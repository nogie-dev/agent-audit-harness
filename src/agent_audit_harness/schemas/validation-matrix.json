{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "type": "string"
          },
          "image": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "image"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array"
    },
    "fixed_recipe": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
    },
    "fixed_recipe_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "poc_review": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
    },
    "poc_review_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "recipe_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "poc_review",
    "poc_review_sha256",
    "recipe_sha256",
    "fixed_recipe",
    "fixed_recipe_sha256",
    "cases"
  ],
  "type": "object"
}
