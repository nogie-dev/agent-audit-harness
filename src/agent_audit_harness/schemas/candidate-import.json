{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-backed candidate intake; imported verdicts remain unvalidated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_index_sha256",
    "fragments",
    "analysis",
    "triage",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "source_index_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hypothesis_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "first_line",
          "last_line",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "first_line": {
            "type": "integer",
            "minimum": 1
          },
          "last_line": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line",
              "cwe",
              "title",
              "reasoning",
              "quote",
              "validation_plan"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "cwe": {
                "type": "string",
                "pattern": "^CWE-[1-9][0-9]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "reasoning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "validation_plan": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root_cause",
              "decisions"
            ],
            "properties": {
              "root_cause": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/cause"
                  }
                ]
              },
              "decisions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "$ref": "#/$defs/decision"
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "anyOf": [
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line",
        "column",
        "quote"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant",
        "description",
        "evidence",
        "fix"
      ],
      "properties": {
        "invariant": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "fix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "description",
            "evidence"
          ],
          "properties": {
            "strategy": {
              "$ref": "#/$defs/label"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "verdict",
        "rationale",
        "counterevidence",
        "unresolved"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^f-[0-9a-f]{16}$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "needs_validation",
            "uncertain",
            "rejected"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "counterevidence": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "evidence"
            ],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "unresolved": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "evidence"
            ],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "evidence": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/evidence"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
