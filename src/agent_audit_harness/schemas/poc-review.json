{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "request_changes"
      ]
    },
    "identity_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "proposal_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "queue_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "recipe_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "review_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "reviewer": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source_index_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "proposal_sha256",
    "candidate_sha256",
    "review_sha256",
    "queue_sha256",
    "source_index_sha256",
    "recipe_sha256",
    "identity_sha256",
    "schema_version",
    "decision",
    "reviewer",
    "rationale"
  ],
  "type": "object"
}
