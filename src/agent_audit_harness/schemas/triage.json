{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "verdict", "rationale"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^f-[0-9a-f]{16}$"},
          "verdict": {"type": "string", "enum": ["needs_validation", "uncertain", "rejected"]},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 3000}
        }
      }
    }
  }
}
